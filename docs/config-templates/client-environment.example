# Engage Core selected-client environment catalog
#
# REFERENCE ONLY. Do not copy this file wholesale into client/[CLIENT_KEY]/.env.
# The real runtime file should contain only values required by the current
# committed client/module deployment plan plus deliberate optional overrides.
#
# Discover the current requirement set:
#   php artisan engage:deployment-plan
#
# Add only missing required variable names:
#   php artisan engage:environment:sync --write-missing
#
# Real secrets must never be committed.

################################
# URLS / HOSTS
################################
# APP_URL=
# ROOT_DOMAIN=
# Messaging public host is derived as messaging.[ROOT_DOMAIN]; do not add MESSAGING_APP_URL.
# CRM_APP_URL=
# WEBINAR_APP_URL=
# SCHEDULING_APP_URL=
#   Optional. Omit to disable the generic public Scheduling surface. When set,
#   use a root-level http:// or https:// origin with no credentials/path/query/fragment.

################################
# DATABASE IDENTITY / CREDENTIALS
################################
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

################################
# CLIENT-SCOPED NAMESPACES
################################
# CACHE_PREFIX=
# REDIS_PREFIX=
# HORIZON_PREFIX=
# SESSION_DOMAIN=

################################
# FILE STORAGE / DIGITALOCEAN SPACES
################################
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_ENDPOINT=
# DO_SPACES_REGION=
# DO_SPACES_BUCKET=
# CDN_BASE_URL=

################################
# EMAIL / MESSAGING
################################
# MAIL_MAILER=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=
# EMAIL_PROVIDER=
# FROM_EMAIL_TRANSACTIONAL=
# FROM_NAME_TRANSACTIONAL=
# FROM_EMAIL_MARKETING=
# FROM_NAME_MARKETING=
#
# Resend credential/webhook notes:
# - outbound-only deployments may use a Sending Access API key;
# - inbound email receiving requires Full Access with the current runtime;
# - RESEND_WEBHOOK_SECRET may contain multiple active endpoint secrets;
# - INBOUND_EMAIL_DOMAIN is the bare Resend receiving domain, commonly
#   replies.[ROOT_DOMAIN]. When Inbound Messaging is enabled, staging/production
#   require this value; local/testing may omit it.
# - Use only the bare receiving domain: no scheme, path, mailbox/local-part,
#   credentials, query, or fragment.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# INBOUND_EMAIL_DOMAIN=
# RESEND_FROM_EMAIL_TRANSACTIONAL=
# RESEND_FROM_NAME_TRANSACTIONAL=
# RESEND_FROM_EMAIL_MARKETING=
# RESEND_FROM_NAME_MARKETING=
# PERMISSION_INVITATION_PUBLIC_URL=
#
# Internal Notifications sender overrides. Normally omit these and inherit the
# shared Messaging MAIL_FROM_ADDRESS / MAIL_FROM_NAME identity. In a live
# deployment, INTERNAL_NOTIFICATION_FROM_ADDRESS becomes required only when the
# shared address fallback is not configured.
# INTERNAL_NOTIFICATION_FROM_ADDRESS=
# INTERNAL_NOTIFICATION_FROM_NAME=
#
# Optional fallback recipient used only when Inbound Messaging and Internal
# Notifications are both enabled and no assigned active team member resolves.
# INBOUND_REPLY_DEFAULT_TEAM_MEMBER_EMAIL=

################################
# PROJECT STATE OWNER
################################
# PROJECT_STATE_ADMIN_EMAIL=

################################
# EXTERNAL FORMS INTAKE
################################
# FORMS_EXTERNAL_INTAKE_ENABLED=
# FORMS_EXTERNAL_INTAKE_CLIENT_ID=
# FORMS_EXTERNAL_INTAKE_CLIENT_SECRET=
# FORMS_EXTERNAL_INTAKE_SOURCE=
# FORMS_EXTERNAL_INTAKE_PROVIDER=
# FORMS_EXTERNAL_INTAKE_ALLOWED_FORMS=
# FORMS_EXTERNAL_INTAKE_DOMAINS=

################################
# SMS / TELNYX
################################
# SMS_ENABLED=
# SMS_PROVIDER=

# Optional provider-neutral sender fallbacks.
# SMS_FROM=
# SMS_FROM_TRANSACTIONAL=
# SMS_FROM_MARKETING=
# TELNYX_API_KEY=
# TELNYX_FROM=
# TELNYX_FROM_TRANSACTIONAL=
# TELNYX_FROM_MARKETING=
# TELNYX_FROM_NOTIFICATIONS=
# TELNYX_WEBHOOK_PUBLIC_KEY=
# MESSAGING_SMS_MARKETING_PROFILE_ID=
# MESSAGING_SMS_TRANSACTIONAL_PROFILE_ID=

################################
# TWILIO ALTERNATE PROVIDER
################################
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_FROM_TRANSACTIONAL=
# TWILIO_FROM_MARKETING=
# TWILIO_VIRTUAL_PHONE=

################################
# WEBINARS / ZOOM
################################
# WEBINAR_PROVIDER=
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_WEBHOOK_SECRET=